    "@types/sql.js": "^1.4.9",
    "cf": "1.0.0-beta.29",
    "sql.js": "^1.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
